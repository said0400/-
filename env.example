# ══════════════════════════════════════════════════════════════════════════════
# 🔑 .env.example — Video Script Generator (2026 Edition)
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to git!
#
# ══════════════════════════════════════════════════════════════════════════════


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       🤖 GEMINI API (Google AI)                             ║
# ║                       Used for: TTS + Image Generation                      ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Main key (required)
GEMINI_API_KEY=AIza...your_main_key_here

# Additional keys for rotation (optional — up to 50)
# More keys = less rate limiting
# GEMINI_API_KEY1=AIza...
# GEMINI_API_KEY2=AIza...
# GEMINI_API_KEY3=AIza...
# GEMINI_API_KEY4=AIza...
# GEMINI_API_KEY5=AIza...
# GEMINI_API_KEY6=AIza...
# GEMINI_API_KEY7=AIza...
# GEMINI_API_KEY8=AIza...
# GEMINI_API_KEY9=AIza...
# GEMINI_API_KEY10=AIza...

# Alternative naming (with underscore):
# GEMINI_API_KEY_1=AIza...
# GEMINI_API_KEY_2=AIza...


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       🧠 GROQ API                                           ║
# ║                       Used for: AI Enrichment (tags, keywords, etc.)        ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Main key (required)
GROQ_API_KEY=gsk_...your_groq_key_here

# Additional keys for rotation (optional — up to 20)
# GROQ_API_KEY1=gsk_...
# GROQ_API_KEY2=gsk_...
# GROQ_API_KEY3=gsk_...
# GROQ_API_KEY4=gsk_...
# GROQ_API_KEY5=gsk_...

# AI operation sleep (seconds between API calls)
# Default: 1.0 | Production: 0.5 | Debug: 2.0
AI_OPERATION_SLEEP=1.0


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       🎥 PEXELS API                                         ║
# ║                       Used for: Stock video fetching                        ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Main key (required)
PEXELS_API_KEY=your_pexels_key_here

# Additional keys for rotation (optional — up to 10)
# PEXELS_API_KEY_1=...
# PEXELS_API_KEY_2=...
# PEXELS_API_KEY_3=...


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       🖼️ PIXABAY API                                        ║
# ║                       Used for: Stock video fetching (backup)               ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Main key (required)
PIXABAY_API_KEY=your_pixabay_key_here

# Additional keys for rotation (optional — up to 10)
# PIXABAY_API_KEY_1=...
# PIXABAY_API_KEY_2=...
# PIXABAY_API_KEY_3=...


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📺 YOUTUBE API (Per-language)                         ║
# ║                       Used for: Publishing videos to YouTube                ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── 🇸🇦 Arabic Channel ──────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID_AR=your_client_id_ar
YOUTUBE_CLIENT_SECRET_AR=your_client_secret_ar
YOUTUBE_REFRESH_TOKEN_AR=your_refresh_token_ar

# ── 🇫🇷 French Channel ──────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID_FR=your_client_id_fr
YOUTUBE_CLIENT_SECRET_FR=your_client_secret_fr
YOUTUBE_REFRESH_TOKEN_FR=your_refresh_token_fr

# ── 🇺🇸 English Channel ─────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID_EN=your_client_id_en
YOUTUBE_CLIENT_SECRET_EN=your_client_secret_en
YOUTUBE_REFRESH_TOKEN_EN=your_refresh_token_en

# ── Fallback (used if per-language not set) ──────────────────────────────────
# YOUTUBE_CLIENT_ID=your_default_client_id
# YOUTUBE_CLIENT_SECRET=your_default_client_secret
# YOUTUBE_REFRESH_TOKEN=your_default_refresh_token


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📘 FACEBOOK API (Per-language)                        ║
# ║                       Used for: Publishing videos to Facebook Pages         ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── 🇸🇦 Arabic Page ─────────────────────────────────────────────────────────
FB_PAGE_ID_AR=your_page_id_ar
FB_PAGE_TOKEN_AR=your_page_token_ar

# ── 🇫🇷 French Page ─────────────────────────────────────────────────────────
FB_PAGE_ID_FR=your_page_id_fr
FB_PAGE_TOKEN_FR=your_page_token_fr

# ── 🇺🇸 English Page ────────────────────────────────────────────────────────
FB_PAGE_ID_EN=your_page_id_en
FB_PAGE_TOKEN_EN=your_page_token_en

# ── Fallback (used if per-language not set) ──────────────────────────────────
# FB_PAGE_ID=your_default_page_id
# FB_PAGE_TOKEN=your_default_page_token

# ── Facebook App (for debug_token + token extension) ─────────────────────────
# Optional but recommended for accurate token validation
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret

# ── Facebook Config (optional) ───────────────────────────────────────────────
# Graph API version (default: v21.0)
FB_API_VERSION=v21.0

# Video state after publish (default: PUBLISHED)
# Options: PUBLISHED | DRAFT | SCHEDULED
FB_VIDEO_STATE=PUBLISHED


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📱 WHATSAPP NOTIFICATIONS (Green-API)                 ║
# ║                       Used for: Sending notifications via WhatsApp          ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Get credentials from: https://green-api.com
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_api_token

# Phone number (without +, with country code)
# Example: 212786850913 (Morocco)
# Example: 966501234567 (Saudi Arabia)
# Example: 33612345678  (France)
# Example: 12125551234  (USA)
WHATSAPP_PHONE_NUMBER=your_phone_number


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📨 TELEGRAM NOTIFICATIONS (Optional)                  ║
# ║                       Used for: Backup notification channel                 ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Get bot token from: @BotFather on Telegram
# Get chat_id from: @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       ⚙️ SYSTEM CONFIGURATION (Optional)                    ║
# ║                       Defaults are usually fine                             ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# AI operation sleep between Groq calls (seconds)
# Lower = faster but more rate limits
# Higher = slower but safer
# Default: 1.0
# AI_OPERATION_SLEEP=1.0

# Facebook Graph API version
# Default: v21.0
# FB_API_VERSION=v21.0

# Facebook video state after publish
# Default: PUBLISHED
# Options: PUBLISHED | DRAFT | SCHEDULED
# FB_VIDEO_STATE=PUBLISHED


# ══════════════════════════════════════════════════════════════════════════════
# 📋 QUICK SETUP GUIDE
# ══════════════════════════════════════════════════════════════════════════════
#
# 1. REQUIRED (minimum to run):
#    - GEMINI_API_KEY     → https://aistudio.google.com/app/apikey
#    - GROQ_API_KEY       → https://console.groq.com/keys
#    - PEXELS_API_KEY     → https://www.pexels.com/api/
#    - PIXABAY_API_KEY    → https://pixabay.com/api/docs/
#
# 2. FOR YOUTUBE PUBLISHING:
#    - YOUTUBE_CLIENT_ID_XX
#    - YOUTUBE_CLIENT_SECRET_XX
#    - YOUTUBE_REFRESH_TOKEN_XX
#    → https://console.cloud.google.com/apis
#
# 3. FOR FACEBOOK PUBLISHING:
#    - FB_PAGE_ID_XX
#    - FB_PAGE_TOKEN_XX
#    → https://developers.facebook.com/
#
# 4. FOR NOTIFICATIONS:
#    - GREEN_API_INSTANCE_ID + TOKEN + PHONE
#    → https://green-api.com
#
# 5. OPTIONAL (backup):
#    - TELEGRAM_BOT_TOKEN + CHAT_ID
#    → @BotFather on Telegram
#
# ══════════════════════════════════════════════════════════════════════════════
#
# 🔑 TIP: For GitHub Actions, add these as Repository Secrets:
#    Settings → Secrets and variables → Actions → New repository secret
#
# ══════════════════════════════════════════════════════════════════════════════
